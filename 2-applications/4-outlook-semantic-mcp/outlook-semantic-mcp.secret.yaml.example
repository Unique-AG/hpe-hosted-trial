apiVersion: v1
kind: Secret
metadata:
  name: outlook-semantic-mcp-secrets
  namespace: unique
type: Opaque
stringData:
  DATABASE_URL: postgresql://outlook_semantic_mcp:change-me@postgres-rw.unique.svc.cluster.local:5432/outlook_semantic_mcp
  AMQP_URL: amqp://change-me
  MICROSOFT_CLIENT_SECRET: change-me
  MICROSOFT_WEBHOOK_SECRET: change-me
  AUTH_HMAC_SECRET: change-me
  ENCRYPTION_KEY: change-me
  UNIQUE_ZITADEL_CLIENT_SECRET: change-me
  PROXY_USERNAME: change-me
  PROXY_PASSWORD: change-me
